# Python bytecode cache
__pycache__/
*.pyc

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj
!CASL_VERA_2D/assets/mesh/casl/*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# CASL VERA Problem 2 -- ephemeral per-run outputs (regenerated by every run of <case>.py; see
# CASL_VERA_2D/README.md's Testing section for what's a committed baseline vs. run output)
CASL_VERA_2D/*/power.txt
CASL_VERA_2D/*/power_raw.txt
CASL_VERA_2D/*/keff.txt
CASL_VERA_2D/*/mesh_*.vtu
CASL_VERA_2D/*/mesh_*.pvtu
CASL_VERA_2D/*/*.restart.h5

# Time-dependent Kobayashi -- per-run outputs of kobayashi_td.py, compare_openmc.py, and
# render_animation.py
Kobayashi_Time_Dependent/kobayashi_td_results.csv
Kobayashi_Time_Dependent/kobayashi_td_summary.csv
Kobayashi_Time_Dependent/kobayashi_td_comparison.png
Kobayashi_Time_Dependent/kobayashi_td_vtk/
Kobayashi_Time_Dependent/kobayashi_td_png/
