FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application foamMultiRun;
regionSolvers
{
    tungsten solid;
    copper solid;
    aluminum solid;
    air solid;
    steel solid;
    water fluid;
}
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 3000;
deltaT 0.1;
writeControl timeStep;
writeInterval 1000;
purgeWrite 2;
writeFormat ascii;
writePrecision 15;
runTimeModifiable false;
libs ("libfieldFunctionObjects.so");
functions
{
    #includeIfPresent "preciceFunctionObject"

    inletMassFlow
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        region water;
        patch waterInlet;
        operation sum;
        fields (phi);
        writeFields false;
        writeControl timeStep;
        writeInterval 1000;
    }
    outletMassFlow
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        region water;
        patch waterOutlet;
        operation sum;
        fields (phi);
        writeFields false;
        writeControl timeStep;
        writeInterval 1000;
    }
    inletTemperature
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        region water;
        patch waterInlet;
        operation areaAverage;
        fields (T);
        writeFields false;
        writeControl timeStep;
        writeInterval 1000;
    }
    outletTemperature
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        region water;
        patch waterOutlet;
        operation areaAverage;
        fields (T);
        writeFields false;
        writeControl timeStep;
        writeInterval 1000;
    }
}
